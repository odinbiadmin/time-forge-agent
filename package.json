{
  "name": "attendance-agent-desktop",
  "version": "1.0.9",
  "description": "Desktop application for managing thermal attendance jobs",
  "main": "main.js",
  "scripts": {
    "dev": "electron . --dev",
    "dev:mon": "nodemon --exec electron . --dev",
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "clean": "rimraf dist"
  },
  "author": "odinbi",
  "license": "ISC",
  "build": {
    "appId": "com.attendance.agent.desktop",
    "productName": "Attendance Agent Desktop",
    "copyright": "Copyright © 2026",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "core/**/*",
      "!core/models/rj1300/licence3500/rj1300_bridge.ps1",
      "renderer/**/*",
      "assets/**/*",
      "!assets/rj1300-sdk{,/**}",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets",
        "filter": [
          "**/*",
          "!rj1300-sdk{,/**}"
        ]
      },
      {
        "from": "assets/rj1300-sdk",
        "to": "rj1300-sdk"
      },
      {
        "from": "core/models/rj1300/licence3500/rj1300_bridge.ps1",
        "to": "rj1300-sdk/rj1300_bridge.ps1"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Attendance-Agent-Desktop-Setup-${version}.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Attendance Agent",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "odinbiadmin",
        "repo": "time-forge-agent",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "axios": "^1.6.5",
    "electron-updater": "^6.8.9",
    "zkteco-js": "^1.7.1"
  },
  "devDependencies": {
    "electron": "^29.4.0",
    "electron-builder": "^24.9.1",
    "electron-reload": "^2.0.0-alpha.1",
    "nodemon": "^3.1.11",
    "rimraf": "^5.0.5"
  }
}
